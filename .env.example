# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Every variable here maps 1:1 onto a field on
# `Settings` in app/core/config.py. Nothing else reads the environment.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_ENV=development
DEBUG=true
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- database --------------------------------------------------------------
# Local development (no server needed):
DATABASE_URL=sqlite+aiosqlite:///./civic.db
# Production (Neon). Paste the URL exactly as Neon gives it to you — the app
# strips `sslmode`/`channel_binding` and rewrites the driver automatically.
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/civic?sslmode=require&channel_binding=require

# --- cors ------------------------------------------------------------------
# Comma-separated. localhost:5173 / :4173 and https://*.vercel.app are always allowed.
CORS_ORIGINS=

# --- ai providers ----------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_ENABLED=true
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=3
GEMINI_API_KEY=

# --- machine learning ------------------------------------------------------
ML_MODEL_PATH=ml/artifacts/model.joblib

# --- seeding / bootstrap admin ---------------------------------------------
# When true, the demo dataset is generated at startup IF the complaints table is empty.
SEED_ON_STARTUP=false
ADMIN_EMAIL=admin@civic.gov.pk
ADMIN_PASSWORD=Admin@123

# --- storage ---------------------------------------------------------------
# Directory for uploaded evidence photos. Set to `none` to disable uploads
# entirely (recommended on hosts without a persistent disk, e.g. Render free).
UPLOAD_DIR=uploads
